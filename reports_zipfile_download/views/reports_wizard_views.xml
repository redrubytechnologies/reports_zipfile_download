<!--  Print Reports Form View  -->
<record id="view_print_reports_wizard_form" model="ir.ui.view">
<field name="name">print.reports.wizard.form</field>
<field name="model">reports.wizard</field>
<field name="arch" type="xml">
<form string="Print Reports Generator">
<style> #report_loader_overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.55); z-index: 99999; flex-direction: column; align-items: center; justify-content: center; } #report_loader_overlay.active { display: flex; } .report_spinner { width: 60px; height: 60px; border: 6px solid #ffffff44; border-top: 6px solid #ffffff; border-radius: 50%; animation: report_spin 0.9s linear infinite; margin-bottom: 18px; } @keyframes report_spin { to { transform: rotate(360deg); } } .report_loader_text { color: #ffffff; font-size: 18px; font-weight: 600; letter-spacing: 0.5px; } </style>
<header>
<button name="generate_report" string="Generate Report" type="object" class="oe_highlight"/>
</header>
<sheet>
<div id="report_loader_overlay">
<div class="report_spinner"/>
<div class="report_loader_text">Generating Report, please wait...</div>
</div>
<div class="oe_title">
<h1>Print Reports Generator</h1>
<p>Select print report type and configure parameters to generate reports</p>
</div>
<field name="report_type" invisible="1"/>
<group string="Report Configuration">
<field name="print_report_type" required="1"/>
</group>
<!--  DC Print Report filters  -->
<group string="DC Print Report Parameters" invisible="print_report_type != 'dc_print_report'">
<group>
<field name="dc_print_dc_number_ids" widget="many2many_tags"/>
<field name="dc_print_from_date"/>
<field name="dc_print_to_date"/>
</group>
<group>
<field name="dc_print_warehouse_id" options="{'no_create': True, 'no_edit': True}"/>
<field name="dc_print_state"/>
</group>
</group>
<!--  PO Print Report filters  -->
<group string="PO Print Report Parameters" invisible="print_report_type != 'po_print_report'">
<group>
<field name="po_print_ids" widget="many2many_tags"/>
<field name="po_print_from_date"/>
<field name="po_print_to_date"/>
</group>
<group>
<field name="po_print_vendor_id" options="{'no_create': True, 'no_edit': True}"/>
<field name="po_print_status"/>
</group>
</group>
<!--  Invoice Print Report filters  -->
<group string="Invoice Print Report Parameters" invisible="print_report_type != 'invoice_print_report'">
<group>
<field name="invoice_print_from_date"/>
<field name="invoice_print_to_date"/>
</group>
<group>
<field name="invoice_print_ids" widget="many2many_tags"/>
<field name="invoice_print_status"/>
</group>
</group>
<!--  Quotation Print Report filters  -->
<group string="Quotation Print Report Parameters" invisible="print_report_type != 'quotation_print_report'">
<group>
<field name="quotation_print_from_date"/>
<field name="quotation_print_to_date"/>
</group>
<group>
<field name="quotation_print_ids" widget="many2many_tags"/>
<field name="quotation_print_status"/>
</group>
</group>
<!--  Installation Print Report Filters  -->
<group string="Installation Print Report Parameters" invisible="print_report_type != 'installation_print_report'">
<group>
<field name="installation_print_from_date"/>
<field name="installation_print_to_date"/>
</group>
<group>
<field name="installation_print_project_ids" widget="many2many_tags"/>
<field name="installation_print_task_ids" widget="many2many_tags"/>
</group>
</group>
<!--  ELCOT Print Report Filters  -->
<group string="ELCOT Print Report Parameters" invisible="print_report_type != 'elcot_print_report'">
<group>
<field name="elcot_print_from_date"/>
<field name="elcot_print_to_date"/>
<field name="elcot_print_state"/>
</group>
<group>
<field name="elcot_print_customer_id" options="{'no_create': True, 'no_edit': True}"/>
<field name="elcot_print_project_ids" widget="many2many_tags"/>
<field name="elcot_print_task_ids" widget="many2many_tags"/>
</group>
</group>
<!--  Download Options (shared for all print reports)  -->
<group string="Download Options" invisible="not print_report_type">
<field name="print_download_type" required="1"/>
</group>
</sheet>
</form>
</field>
</record>

